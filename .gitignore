# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Native decoded review frames are preserved locally and reproducible from the
# versioned source clips. Keep review sheets, hashes and reports in Git.
/docs/qa-v33/**/*.png
!/docs/qa-v33/opening/*-proof.png
# Preserve raw encoder logs locally; version the structured reports and reviews.
/docs/qa-v33/**/*.log

# Reproducible native pose review crops and rejected candidate rasters stay local.
# Final source atlases, prompts, manifests and review reports remain versioned.
/art-source/v36/**/rejected-*/**/*.png
/art-source/v36/**/rejected-*.png

/art-source/v36/variants/*/review/**/*.png
/art-source/v36/variants/*/proofs/*.png
/art-source/v36/variants/*/native-crop-proof/**/*.png
/art-source/v36/variants/*/rejected-*/**/*.png
/art-source/v36/variants/*/*-rejected-*.png
/art-source/v36/variants/marin-starless-throne/*-attempt.png
/art-source/v36/skills/*/candidate-atlas.png
/art-source/v36/variants/*/portrait-candidate.png
/art-source/v36/variants/ava-worldroot-sovereign/walk-layout-source.png
/art-source/v36/variants/max-thunder-requiem/*-compact-source.png
/art-source/v36/variants/beatriz-eclipse-tide/*candidate.png
